  </ItemGroup>

  <ItemGroup>
    <!-- Hand SQL executed by migrations (design §11.1 rule 2), read through SqlResource. -->
    <EmbeddedResource Include="Infrastructure\Persistence\BudgetContexts\Sql\*.sql" />
  </ItemGroup>
